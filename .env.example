# Copy to .env.local and fill in. Never commit .env.local.
# Everything here is SERVER-ONLY — no NEXT_PUBLIC_ prefix, ever.
# A NEXT_PUBLIC_ prefix on any of these ships the value to the browser.

# ── MongoDB ──────────────────────────────────────────────────────────
# Stores form submissions only (contact, meetings, applications).
# Never page content. Contains credentials — treat as a secret.
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local:  mongodb://127.0.0.1:27017
MONGODB_URI=

# Database name. Collections are created on first write.
MONGODB_DB=crandev

# ── GitHub (Ship Log / open-source section) ──────────────────────────
# Optional. Without it the API still works at a lower unauthenticated
# rate limit, and the section falls back to content/ on failure.
# Needs public_repo scope only — never a token with write access.
GITHUB_TOKEN=

# Which account the Ship Log reads from.
GITHUB_OWNER=

# ── Site ─────────────────────────────────────────────────────────────
# Absolute origin, used for OG tags and canonical URLs. No trailing slash.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
